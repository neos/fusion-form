prototype(Neos.Fusion.Form:Date)  < prototype(Neos.Fusion.Form:Component.Field) {

    dateFormat = 'Y-m-d'

    field.dateFormat = ${props.dateFormat}

    attributes.type = 'date'

    renderer = afx`
        <input
            name={field.getName()}
            value={field.getCurrentValueStringified() || field.getTargetValueStringified()}
            {...props.attributes}
        />
    `
}
